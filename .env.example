# Alperler Rent A Car - production environment template
# Keep real secrets only in Vercel/Supabase settings. Never commit secret values.

# Public application origin
# Temporary production host. Replace with the purchased custom domain after it is connected.
PUBLIC_APP_URL=https://alperauto.vercel.app

# Supabase public connection
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only Supabase credential used by trusted APIs.
# NEVER expose this value to browser code or NEXT/VITE public variables.
SUPABASE_SERVICE_ROLE_KEY=

# Payment integration
# Recommended for a Turkey-based merchant: PAYTR
PAYMENT_PROVIDER=paytr
PAYMENT_ALLOWED_ORIGINS=https://alperauto.vercel.app
PAYMENT_CARD_ENABLED=false
PAYMENT_EFT_ENABLED=true
PAYMENT_OFFICE_ENABLED=true

# PayTR server-only credentials
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# Optional generic hosted provider fallback
PAYMENT_CREATE_SESSION_URL=
PAYMENT_SECRET_KEY=
PAYMENT_MERCHANT_ID=

# Telematics / GPS provider bridge
# The bridge is provider-specific. Keep secrets only in Supabase Edge Function secrets.
TELEMATICS_COMMAND_URL=
TELEMATICS_COMMAND_SECRET=
TELEMATICS_WEBHOOK_SECRET=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Set this to the Graph/Marketing API version supported by the connected Meta app.
# Keep it blank until that account/app is connected and verified.
META_GRAPH_VERSION=

# Vercel transactional SMTP endpoint, if used
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_ADMIN_TO=
EMAIL_ALLOWED_RECIPIENTS=

# Supabase booking-notify uses Resend secrets in Supabase Edge Function settings
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMS - optional Twilio integration
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Optional outbound webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Runtime compatibility
NODE_ENV=production
