# Canonical public application URL used by server-side origin validation.
PUBLIC_APP_URL=https://alperrentacar.online

# Payment gateway adapter.
# Keep PAYMENT_PROVIDER=none until a real hosted payment provider is connected.
# Set PAYMENT_CARD_ENABLED=true only after PAYMENT_CREATE_SESSION_URL and secrets are configured.
PAYMENT_PROVIDER=none
PAYMENT_CARD_ENABLED=false
PAYMENT_CREATE_SESSION_URL=
PAYMENT_SECRET_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_ALLOWED_ORIGINS=https://www.alperrentacar.online
PAYMENT_EFT_ENABLED=true
PAYMENT_OFFICE_ENABLED=true

# SMTP settings for transactional email.
# Use provider credentials in Vercel Environment Variables, never commit live secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alperlerauto@gmail.com
SMTP_PASS=
MAIL_FROM=alperlerauto@gmail.com
MAIL_ADMIN_TO=alperlerauto@gmail.com
EMAIL_ALLOWED_RECIPIENTS=alperlerauto@gmail.com
