# Alperler Rent A Car - production environment template
# Keep real secrets only in Vercel/Supabase settings. Never commit secret values.

# Public application origin used by browser-visible canonical/payment links when a real custom domain exists.
# IMPORTANT: keep blank until the domain is registered, connected to the production project and serving HTTPS.
# Vercel production/deployment hosts remain automatic fallbacks while these are blank.
PUBLIC_APP_URL=
APP_PUBLIC_ORIGIN=
SITE_URL=

# Public site origin used by hardened Supabase Edge Function origin allowlists.
PUBLIC_SITE_URL=

# Supabase public connection used by the browser and same-origin BFF.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only Supabase credential used by trusted APIs.
# NEVER expose this value to browser code or VITE/NEXT public variables.
SUPABASE_SERVICE_ROLE_KEY=

# Payment integration
# PayTR and iyzico may both be configured at the same time.
# The active customer-card provider is selected from Admin > Ödeme ve Depozito.
# PAYMENT_PROVIDER is only a server status/bootstrap preference when both credentials are present.
# Valid values: paytr, iyzico, none
PAYMENT_PROVIDER=paytr
# Add only registered HTTPS production origins that actually serve this application.
# Vercel's production/deployment origins are derived automatically by the runtime.
PAYMENT_ALLOWED_ORIGINS=
PAYMENT_CARD_ENABLED=false
PAYMENT_EFT_ENABLED=true
PAYMENT_OFFICE_ENABLED=true

# PayTR server-only credentials
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# iyzico sandbox server-only credentials
# Used when Admin > Ödeme ve Depozito > Test / sandbox modu is enabled.
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=

# iyzico production server-only credentials
# Used only when iyzico is selected and Test / sandbox modu is disabled.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Telematics / GPS provider bridge
# Keep secrets only in Supabase Edge Function secrets.
TELEMATICS_COMMAND_URL=
TELEMATICS_COMMAND_SECRET=
TELEMATICS_WEBHOOK_SECRET=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Set this to the Graph/Marketing API version supported by the connected Meta app.
META_GRAPH_VERSION=

# Vercel transactional SMTP endpoint, if used
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_ADMIN_TO=
EMAIL_ALLOWED_RECIPIENTS=

# Supabase booking-notify uses Resend secrets in Supabase Edge Function settings
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMS - optional Twilio integration
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Optional outbound webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Runtime compatibility
NODE_ENV=production
