# Alperler Auto - Vercel environment template
# Keep real secrets only in Vercel/Supabase settings. Never commit secret values.

# Public application origin
PUBLIC_APP_URL=https://your-production-domain.example

# Supabase public connection
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Payment integration
PAYMENT_PROVIDER=none
PAYMENT_CREATE_SESSION_URL=
PAYMENT_SECRET_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_ALLOWED_ORIGINS=https://your-production-domain.example
PAYMENT_CARD_ENABLED=false
PAYMENT_EFT_ENABLED=true
PAYMENT_OFFICE_ENABLED=true

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_ADMIN_TO=
EMAIL_ALLOWED_RECIPIENTS=

# SMS - optional Twilio integration
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Optional outbound webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional Firebase/Google integration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Runtime compatibility
NODE_ENV=production
