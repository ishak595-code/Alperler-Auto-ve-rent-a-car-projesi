# Public application URL. Set this to the final production domain when connected.
PUBLIC_APP_URL=https://example.com

# Payment gateway adapter.
# Keep PAYMENT_PROVIDER=none until a real provider/gateway adapter is connected.
# Set PAYMENT_CARD_ENABLED=true only after PAYMENT_CREATE_SESSION_URL and secrets are configured.
PAYMENT_PROVIDER=none
PAYMENT_CARD_ENABLED=false
PAYMENT_CREATE_SESSION_URL=
PAYMENT_SECRET_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_ALLOWED_ORIGINS=
PAYMENT_EFT_ENABLED=true
PAYMENT_OFFICE_ENABLED=true

# SMTP Settings for transactional email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional server-side Firebase identifiers for integration health checks / future Admin SDK wiring.
FIREBASE_PROJECT_ID=
