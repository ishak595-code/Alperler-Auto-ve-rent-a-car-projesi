# Alperler Rent A Car - production environment template
# Keep real secrets only in Supabase Vault or server environment settings. Never commit secret values.

# Canonical public application origin.
# Keep blank until the final HTTPS domain is connected. Same-origin request handling remains authoritative.
# APP_PUBLIC_ORIGIN is the preferred provider-neutral name. PUBLIC_APP_URL and SITE_URL are compatibility aliases.
PUBLIC_APP_URL=
APP_PUBLIC_ORIGIN=
SITE_URL=

# Additional trusted browser origins for same-origin/BFF APIs, comma separated.
# Usually leave blank when the browser and API share one origin. Add only verified HTTPS application origins.
APP_ALLOWED_ORIGINS=

# Public site origin used by hardened Supabase Edge Function origin allowlists.
PUBLIC_SITE_URL=

# Supabase public connection used by the browser and same-origin BFF.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only Supabase credential used by trusted APIs.
# NEVER expose this value to browser code or VITE/NEXT public variables.
SUPABASE_SERVICE_ROLE_KEY=

# Payment integration
# PayTR and iyzico may both be configured at the same time.
# Preferred provider credentials are entered from Admin > Ödeme ve Depozito and encrypted in Supabase Vault.
# The environment credential variables below remain server-only fallback/compatibility options.
# The active customer-card provider is selected from Admin > Ödeme ve Depozito.
# PAYMENT_PROVIDER is only a server status/bootstrap preference when environment credentials are present.
# Valid values: paytr, iyzico, none
PAYMENT_PROVIDER=paytr
# Add only registered HTTPS production origins that actually serve this application.
PAYMENT_ALLOWED_ORIGINS=
# Emergency-only server kill switch. Normal card activation is controlled from Admin and the database.
# false = Admin may activate a fully configured provider; true = all card session creation is blocked immediately.
PAYMENT_CARD_KILL_SWITCH=false
PAYMENT_EFT_ENABLED=true
PAYMENT_OFFICE_ENABLED=true

# PayTR server-only environment fallback credentials.
# Normally enter these from Admin so they are encrypted in Supabase Vault instead.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# true forces PayTR test_mode=1 even if Admin test/sandbox is off.
# Leave false for normal Admin-controlled test/live switching.
PAYTR_TEST_MODE=false

# iyzico sandbox server-only environment fallback credentials.
# Normally enter these from Admin > iyzico Sandbox Bağlantısı.
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=

# iyzico production server-only environment fallback credentials.
# Normally enter these from Admin > iyzico Canlı Bağlantısı.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Telematics / GPS provider bridge
# Keep secrets only in Supabase Edge Function secrets.
TELEMATICS_COMMAND_URL=
TELEMATICS_COMMAND_SECRET=
TELEMATICS_WEBHOOK_SECRET=

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Set this to the Graph/Marketing API version supported by the connected Meta app.
META_GRAPH_VERSION=

# Transactional SMTP endpoint, if used by the selected host runtime.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_ADMIN_TO=
EMAIL_ALLOWED_RECIPIENTS=

# Supabase booking-notify uses Resend secrets in Supabase Edge Function settings
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMS - optional Twilio integration
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Optional outbound webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# Runtime compatibility
NODE_ENV=production
PORT=3000
