rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'admin@alperler.com'; } // Note: we can use a custom claim or email.

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function validateSize(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(configId);
    }

    match /inventory/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(vehicleId);
    }

    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(memberId);
    }

    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(tourId);
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(postId);
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(faqId);
    }

    // Interaction collections
    
    // Reservations: Anyone can create if they provide basic info, only admin can read to protect PII, admin can update/delete
    match /reservations/{reservationId} {
      function isValidBooking(data) {
        return (data.keys().hasAll(['status', 'customerName', 'customerPhone'])) &&
               validateSize(data.customerName, 2, 100) &&
               validateSize(data.customerPhone, 10, 20);
      }
      
      allow create: if isValidId(reservationId) && isValidBooking(incoming()) && incoming().status == 'PENDING';
      allow read, update, delete: if isAdmin();
    }

    // Partner Requests
    match /partnerRequests/{requestId} {
      function isValidPartnerReq(data) {
        return data.keys().hasAll(['name', 'phone', 'carBrand']) &&
               validateSize(data.name, 2, 100) &&
               validateSize(data.phone, 10, 20);
      }
      allow create: if isValidId(requestId) && isValidPartnerReq(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Feedbacks
    match /feedbacks/{feedbackId} {
      function isValidFeedback(data) {
        return data.keys().hasAll(['message', 'rating']) &&
               validateSize(data.message, 1, 1000) &&
               data.rating is number && data.rating >= 1 && data.rating <= 5;
      }
      allow create: if isValidId(feedbackId) && isValidFeedback(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Subscribers
    match /subscribers/{subscriberId} {
      function isValidSubscriber(data) {
        return data.keys().hasAll(['email']) &&
               validateSize(data.email, 5, 100);
      }
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Notifications (Admin log only)
    match /notifications/{notificationId} {
      allow read, write: if isAdmin() && isValidId(notificationId);
    }
  }
}
