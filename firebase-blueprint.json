{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Represents a rental or sales vehicle.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "category": { "type": "string", "enum": ["RENTAL", "SALE", "TOUR"] },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "images": { "type": "array" },
        "features": { "type": "array" },
        "status": { "type": "string", "enum": ["AVAILABLE", "UNAVAILABLE", "SOLD", "RESERVED"] }
      },
      "required": ["brand", "model", "category", "price", "status"]
    },
    "BookingRequest": {
      "title": "BookingRequest",
      "description": "A reservation or inquiry request made by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "carId": { "type": "string", "description": "Reference to Vehicle" },
        "type": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "pickupLocation": { "type": "string" },
        "pickupDate": { "type": "string" },
        "returnDate": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "COMPLETED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "customer", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "App user or admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "vehicles": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Collection of all vehicles (rental, sale, and tour options)."
    },
    "bookingRequests": {
      "schema": { "$ref": "#/entities/BookingRequest" },
      "description": "Collection of reservation and inquiry requests."
    },
    "users": {
        "schema": { "$ref": "#/entities/User" },
        "description": "User profiles."
    },
    "admins": {
      "schema": "string",
      "description": "List of admin UIDs for RBAC."
    }
  }
}
