def remove_method(src, signature):
    start = src.find(signature)
    if start < 0:
        raise SystemExit(f"Method not found: {signature}")
    brace = src.find("{", start)
    depth = 0
    quote = None
    escape = False
    for i in range(brace, len(src)):
        ch = src[i]
        if quote:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == quote:
                quote = None
        else:
            if ch in ("'", '"', "`"):
                quote = ch
            elif ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    end = i + 1
                    while end < len(src) and src[end] in "\r\n":
                        end += 1
                    return src[:start] + src[end:]
    raise SystemExit(f"Unclosed method: {signature}")

