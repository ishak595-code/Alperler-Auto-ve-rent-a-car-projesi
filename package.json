    "a11y:dates": "node scripts/check-date-controls.mjs",
    "media:vehicles": "node scripts/check-vehicle-media.mjs",
    "vercel:functions": "node scripts/check-vercel-function-budget.mjs",
    "design:premium": "node scripts/check-premium-design-system.mjs",
    "pwa:installability": "node scripts/check-pwa-installability.mjs",
    "security:v165": "node scripts/check-v165-production-hardening.mjs",
    "customer-experience:v207": "node scripts/check-v207-customer-experience.mjs",
    "database-source:v207": "node scripts/check-v207-database-source-contract.mjs",
    "repository-governance:v208": "node scripts/check-v208-repository-governance.mjs",
