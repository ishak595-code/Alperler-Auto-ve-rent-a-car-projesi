{
  "name": "alperler-rent-a-car",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "ng build && node --import tsx server.ts",
    "start": "node --import tsx server.ts",
    "build": "ng build",
    "lint": "tsc --noEmit",
    "a11y:buttons": "node scripts/check-accessible-buttons.mjs",
    "a11y:dates": "node scripts/check-date-controls.mjs",
    "media:vehicles": "node scripts/check-vehicle-media.mjs",
    "vercel:functions": "node scripts/check-vercel-function-budget.mjs",
    "design:premium": "node scripts/check-premium-design-system.mjs",
    "pwa:installability": "node scripts/check-pwa-installability.mjs",
    "security:v165": "node scripts/check-v165-production-hardening.mjs",
    "preview": "ng serve --configuration=production"
  },
  "dependencies": {
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/forms": "21.2.21",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.21",
    "@angular/router": "21.2.21",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "9.0.5",
    "pdfkit": "^0.18.0",
    "rxjs": "^7.8.2",
    "swiper": "^12.1.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.21",
    "@tailwindcss/postcss": "4.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.6",
    "archiver": "^8.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.2.1",
    "typescript": "~5.9.3"
  }
}
