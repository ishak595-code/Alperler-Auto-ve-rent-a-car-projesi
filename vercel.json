{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https:; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests" }
    ]},
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
      { "key": "CDN-Cache-Control", "value": "no-store" }
    ]},
    { "source": "/index.html", "headers": [
      { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
      { "key": "CDN-Cache-Control", "value": "no-store" }
    ]},
    { "source": "/manifest.json", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
      { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
    ]},
    { "source": "/service-worker.js", "headers": [
      { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
      { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ]},
    { "source": "/offline.html", "headers": [
      { "key": "Content-Type", "value": "text/html; charset=utf-8" },
      { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
    ]},
    { "source": "/catalog-media/:path*", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
    ]},
    { "source": "/admin/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
      { "key": "Cache-Control", "value": "no-store" }
    ]},
    { "source": "/branch-portal/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
      { "key": "Cache-Control", "value": "no-store" }
    ]},
    { "source": "/track-car/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
      { "key": "Cache-Control", "value": "no-store" }
    ]},
    { "source": "/booking-checkout/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
      { "key": "Cache-Control", "value": "no-store" }
    ]},
    { "source": "/api/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "Cache-Control", "value": "no-store" }
    ]}
  ],
  "rewrites": [
    { "source": "/api/contact-admin", "destination": "/api/contact?mode=admin" },
    { "source": "/api/partner-requests", "destination": "/api/partner?op=requests" },
    { "source": "/api/partner-media", "destination": "/api/partner?op=media" },
    { "source": "/api/partner-upload-resume", "destination": "/api/partner?op=resume" },
    { "source": "/api/payments/create-session", "destination": "/api/payments?op=create-session" },
    { "source": "/api/payments/paytr-callback", "destination": "/api/payments?op=paytr-callback" },
    { "source": "/api/integrations/status", "destination": "/api/bookings?mode=integration-status" },
    { "source": "/api/rental-availability", "destination": "/api/bookings?mode=rental-availability" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot).*" }],
      "destination": "/api/social-preview?kind=home"
    },
    {
      "source": "/fleet/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot).*" }],
      "destination": "/api/social-preview?kind=fleet&id=:id"
    },
    {
      "source": "/sales/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot).*" }],
      "destination": "/api/social-preview?kind=sales&id=:id"
    },
    {
      "source": "/tour/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot).*" }],
      "destination": "/api/social-preview?kind=tour&id=:id"
    },
    {
      "source": "/blog/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot).*" }],
      "destination": "/api/social-preview?kind=blog&id=:id"
    },
    {
      "source": "/branches/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot).*" }],
      "destination": "/api/social-preview?kind=branch&id=:id"
    },
    { "source": "/catalog-media/:path*", "destination": "https://hrztrgjvgdnaurejnsgs.supabase.co/storage/v1/object/public/catalog-media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
